+// t3 (2026-11-07): the commonly-asked apple80211 commands the probe gate now lets
+// through. Layouts from itlwm's apple80211_ioctl.h; caller buffer sizes read from
+// IO80211Family (getNSS 8 B, getCHANNELS_INFO 0x2720 B) - writes stay far inside.
+IOReturn MtkWlanNativeIf::getNSS(apple80211_nss_data *d) {
+    nativeCall(ctl, 'S', 510);
+    if (!d) return kIOReturnBadArgument;
+    store<uint32_t>(d, 0, 1);        // version
+    store<uint8_t>(d, 4, 2);        // 2 spatial streams (HE 2x2 160 MHz)
+    return kIOReturnSuccess;
+}
+
+IOReturn MtkWlanNativeIf::getCHANNELS_INFO(apple80211_channels_info *d) {
+    nativeCall(ctl, 'S', 483);
+    if (!d) return kIOReturnBadArgument;
+    static const uint8_t chans[] = {1, 6, 11, 36, 40, 44, 48, 149, 153, 157, 161, 165};
+    const unsigned n = (unsigned)(sizeof(chans) / sizeof(chans[0]));
+    store<uint32_t>(d, 0, 1);       // version
+    store<uint32_t>(d, 4, 0);       // unk1
+    store<uint16_t>(d, 8, (uint16_t)n);
+    for (unsigned i = 0; i < n; i++)
+        store<uint16_t>(d, 10 + 2 * i, (uint16_t)((chans[i] << 2) | 0));  // chan_spec, 20 MHz
+    return kIOReturnSuccess;
+}
+
+IOReturn MtkWlanNativeIf::setPM_MODE(apple80211_pm_mode *) {
+    nativeCall(ctl, 'S', 587);
+    return kIOReturnSuccess;        // accepted; the core owns power management
+}
+
+IOReturn MtkWlanNativeIf::setROAM_PROFILE(apple80211_roam_profile_all_bands *) {
+    nativeCall(ctl, 'S', 564);
+    return kIOReturnSuccess;        // accepted; roaming is driven by the core
+}
+
+IOReturn MtkWlanNativeIf::setWCL_ROAM_PROFILE_CONFIG(apple80211_roam_profile_config *) {
+    nativeCall(ctl, 'S', 596);
+    return kIOReturnSuccess;
+}
+
